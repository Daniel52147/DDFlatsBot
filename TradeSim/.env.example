# Скопируй в .env и заполни (файл .env в git не попадает)
# cp .env.example .env

# Binance TESTNET — https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXCHANGE_ENABLED=true
EXCHANGE_SYNC_TO_PAPER=true
# Опционально: paper bot/manual сделки → testnet (осторожно!)
# EXCHANGE_SYNC_FROM_PAPER=true

# v37 — auto testnet when keys set
# AUTO_APPLY_TRADING_MODE_ON_START=true
# TRADING_MODE_DEFAULT=testnet

# v36 — Live prep (7 дней к реальным деньгам)
# LIVE_REQUIRE_READINESS=true
# LIVE_MIN_DAYS_TESTNET=3
# LIVE_MIN_TRADES=30
# LIVE_MAX_ORDER_USD=25
# LIVE_BYPASS_READINESS=false

# v35 — profit focus (pause losers, boost leaders)
# PROFIT_FOCUS_ENABLED=true
# PROFIT_FOCUS_PAUSE_VS_HOLD=-2.0
# PROFIT_FOCUS_BOOST_MIN_VS_HOLD=0.5
# PROFIT_MAX_ON_START=true

# v33 — trading mode menu
# TRADING_MODE_DEFAULT=paper
# EXCHANGE_ENABLED=true
# EXCHANGE_TESTNET=true
# EXCHANGE_SYNC_FROM_PAPER=true

# TRADE_MODE=active
# ACTIVE_TRADE_ON_START=true
# ACTIVE_TRADE_RESET_TIMERS=false

# AUTO_TACTICS_BACKTEST_ENABLED=true
# AUTO_TACTICS_BACKTEST_MIN_EDGE=0.5
# PORTFOLIO_MAX_DRAWDOWN_PCT=12
# REGIME_FILTER_ENABLED=true
# SHADOW_LAB_ENABLED=true
# SHADOW_MIN_TRADES_PROMOTE=8
# EXCHANGE_MAX_ORDER_USD=100

# v27 — walk-forward & correlation
# SHADOW_WALKFORWARD_ENABLED=true
# SHADOW_WALKFORWARD_MIN_EDGE=0.3
# CORRELATION_RISK_ENABLED=true
# CORRELATION_RISK_MIN_BEARISH=6

# v28 — allocator & testnet PnL
# CAPITAL_ALLOCATOR_ENABLED=true
# CAPITAL_ALLOCATOR_BOOST=1.15
# STRATEGY_OUTCOME_EVAL_SEC=7200

# Опционально: защита write-API при доступе из интернета
# TRADESIM_API_TOKEN=придумай-свой-секрет
# TRADESIM_BIND_HOST=0.0.0.0
