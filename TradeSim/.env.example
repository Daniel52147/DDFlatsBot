# Binance TESTNET — https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXCHANGE_ENABLED=true
EXCHANGE_SYNC_TO_PAPER=true
# Опционально: paper bot/manual сделки → testnet (осторожно!)
