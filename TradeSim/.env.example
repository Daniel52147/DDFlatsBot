# Скопируй в .env и заполни (файл .env в git не попадает)
# cp .env.example .env

# Быстрая настройка Testnet:  python scripts/apply_testnet_env.py
# Или Windows:  .\setup-env.bat

# Binance TESTNET — https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXCHANGE_ENABLED=true
EXCHANGE_TESTNET=true
EXCHANGE_SYNC_TO_PAPER=true
EXCHANGE_SYNC_FROM_PAPER=true
EXCHANGE_MAX_ORDER_USD=25

# v46 — путь к Live
# LIVE_MICRO_ORDER_USD=10
# LIVE_MICRO_DCA_HOURS=12
# LIVE_MICRO_MAX_TRADES_PER_DAY=3
# WALLET_BRIDGE_ENABLED=true
# WALLET_BRIDGE_INTERVAL_SEC=45
# EXCHANGE_MAX_WITHDRAW_USD=500
# EXCHANGE_DEPOSIT_NETWORK=TRC20
# EXCHANGE_WITHDRAW_NETWORK=TRC20

# v47 — Telegram + TradingView + Protections
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_ALLOWED_USER_IDS=123456789
# TRADINGVIEW_WEBHOOK_ENABLED=true
# TRADINGVIEW_WEBHOOK_SECRET=придумай-секрет-для-TV
# TRADINGVIEW_DEFAULT_SIZE_USD=10
# PROTECTIONS_ENABLED=true
# PROTECTION_STOPLOSS_COUNT=3
# PROTECTION_COOLDOWN_LOSSES=5

# Безопасность
# TRADESIM_API_TOKEN=придумай-секрет   # обязателен для 0.0.0.0 и телефона
# TRADESIM_BIND_HOST=0.0.0.0          # телефон в той же Wi-Fi
# TRADESIM_PHONE_ACCESS=true           # /open даёт IP 192.168.x.x (не 127.0.0.1)
# TELEGRAM_FREE_CHAT=true
# TRADESIM_PUBLIC_URL=                 # пусто = авто LAN IP
# LIVE_ALLOW_FORCE=false

# Режим: paper | testnet | live
TRADING_MODE_DEFAULT=testnet
AUTO_APPLY_TRADING_MODE_ON_START=true
PAPER_LEARN_ENABLED=false
TRADE_MODE=normal
ACTIVE_TRADE_ON_START=false

# Paper learn (больше сделок на Paper)
# PAPER_LEARN_ENABLED=true

# Live prep
# LIVE_REQUIRE_READINESS=true
# LIVE_MIN_DAYS_TESTNET=3
# LIVE_MIN_TRADES=30
# LIVE_MAX_ORDER_USD=25

# Торговля
# TRADE_MODE=active
# EXCHANGE_MAX_ORDER_USD=100
# REGIME_FILTER_ENABLED=false
